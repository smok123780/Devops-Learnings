{
    "displayName": "High CPU usage",
    "combiner": "OR",
    "conditions": [
      {
        "displayName": "VM CPU > 80% for 5m",
        "conditionThreshold": {
          "filter": "metric.type=\"compute.googleapis.com/instance/cpu/utilization\" resource.type=\"gce_instance\"",
          "comparison": "COMPARISON_GT",
          "thresholdValue": 0.8,
          "duration": "300s",
          "aggregations": [
            {
              "alignmentPeriod": "60s",
              "perSeriesAligner": "ALIGN_MEAN"
            }
          ]
        }
      }
    ],
    "alertStrategy": {
      "autoClose": "1800s"
    },
    "enabled": true
  }